# Entorno: en 'production' JWT_SECRET y CORS_ORIGINS son OBLIGATORIOS (el servidor no arranca sin ellos)
NODE_ENV=development
# Secreto de firma JWT: mínimo 16 caracteres; en producción usar un valor largo y aleatorio
JWT_SECRET=bankhub-dev-secret
# Orígenes permitidos por CORS, separados por comas (URL pública del frontend)
CORS_ORIGINS=http://localhost:3000
PORT=4000

# SMTP para recuperación de contraseña
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@bankhub.local

# Opcional para pruebas locales con MailHog
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false

DATABASE_URL="postgresql://bankhub:bankhub_dev@localhost:5432/bankhub?schema=public"

# --- Producción (Railway + Supabase + Sentry) ---
# Supabase: usar el "Session pooler" (puerto 5432) para el backend en Railway (IPv4). Ver docs/DEPLOY.md
# DATABASE_URL="postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
# Sentry (opcional; sin DSN queda desactivado)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Swagger se desactiva en producción salvo ENABLE_SWAGGER=true
# ENABLE_SWAGGER=false
